# Copy to .env (gitignored). Loaded by vine.common.config.Settings.
# Nothing secret should ever be committed.

# Where the pipeline reads/writes data (override for NRP CephFS/S3 mounts).
VINE_DATA_DIR=./data
VINE_MODELS_DIR=./models

# Global RNG seed for reproducible runs.
VINE_SEED=42
VINE_LOG_LEVEL=INFO

# --- InfluxDB: primary live sensor source (ThingsBoard/LoRaWAN at IHV) ---
# Token is an NRP secret — get the current one from the mentor, never commit it.
VINE_INFLUX_URL=https://nrp-thingsboard-influxdb.nrp-nautilus.io
VINE_INFLUX_ORG=Iron Horse Vineyards
VINE_INFLUX_BUCKET=ihv
VINE_INFLUX_TOKEN=

# --- National Data Platform (published dataset exports) ---
VINE_NDP_BASE_URL=https://nationaldataplatform.org
VINE_NDP_ORG=iron-horse-vineyards
VINE_NDP_API_KEY=               # set for private/embargoed datasets

# --- NRP experiment tracking (MLflow self-hosted; empty -> local ./mlruns) ---
MLFLOW_TRACKING_URI=

# --- NRP object storage (S3-compatible Ceph; creds from portal /s3token/) ---
VINE_S3_ENDPOINT_URL=https://s3-west.nrp-nautilus.io
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- NRP managed LLM (OpenAI-compatible; token from portal /llmtoken/) ---
VINE_NRP_LLM_BASE_URL=https://ellm.nrp-nautilus.io/v1
VINE_NRP_LLM_API_KEY=
